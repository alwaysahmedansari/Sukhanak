rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // صرف عام تصویری اقسام (SVG جان بوجھ کر شامل نہیں)
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function smallerThanMB(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // کور تصاویر: covers/{uid}/{فائل}
    match /covers/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && isImage() && smallerThanMB(4);
      allow delete: if isOwner(uid);
    }

    // پروفائل تصاویر: avatars/{uid}/{فائل}
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && isImage() && smallerThanMB(1);
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 
